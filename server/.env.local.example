# Local development - copy to .env.local and use
# Server auto-loads .env.local when NODE_ENV !== production

PORT=3001
NODE_ENV=development

# Local URLs
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3001

# Google OAuth - same credentials work for both local and production
# In Google Cloud Console, add BOTH redirect URIs:
#   - http://localhost:3001/api/auth/callback
#   - https://YOUR-RAILWAY-URL/api/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

SESSION_SECRET=local-dev-secret
JWT_SECRET=local-dev-jwt-secret
