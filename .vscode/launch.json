{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/webapp",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "Launch Chrome (preview)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4173",
      "webRoot": "${workspaceFolder}/webapp"
    },
    {
      "name": "Debug Vite in Terminal",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/webapp",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Dev + Chrome",
      "configurations": ["Debug Vite in Terminal", "Launch Chrome (dev)"]
    }
  ]
}
